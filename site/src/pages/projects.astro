---
import Layout from "../layouts/Layout.astro";
import { projects } from "../data/site";
import { lanes, nodes } from "../data/architecture";

const first = nodes[0];

const auditHeaders = [
  { name: "Strict-Transport-Security", purpose: "Forces HTTPS" },
  {
    name: "Content-Security-Policy",
    purpose: "Limits what the page can load and run",
  },
  { name: "X-Content-Type-Options", purpose: "Stops MIME-type sniffing" },
  {
    name: "Referrer-Policy",
    purpose: "Limits what is sent when following links",
  },
  {
    name: "Permissions-Policy",
    purpose: "Turns off browser features the site does not use",
  },
  {
    name: "X-Frame-Options",
    purpose: "Blocks the site from being embedded elsewhere",
  },
  {
    name: "Cross-Origin-Opener-Policy",
    purpose: "Isolates the page from other windows",
  },
];
---

<Layout
  title="Projects"
  description="Projects with architecture and engineering notes."
>
  <section id="projects">
    <h1>Projects</h1>

    {
      projects.map((p) => (
        <article class="project" id={p.slug}>
          <h2>{p.title}</h2>
          <p>{p.summary}</p>

          <dl class="rows facts">
            <dt>Stack</dt>
            <dd>{p.stack.join(", ")}</dd>
            {p.details.map((d) => (
              <>
                <dt>{d.label}</dt>
                <dd>{d.text}</dd>
              </>
            ))}
          </dl>

          {p.links.length > 0 && (
            <p class="links">
              {p.links.map((l) => (
                <a href={l.href} target="_blank" rel="noopener">
                  {l.label}
                </a>
              ))}
            </p>
          )}
        </article>
      ))
    }
  </section>

  <section id="architecture">
    <h2>Architecture</h2>
    <p>
      Select a service to see what it does in this project and why I chose it.
    </p>

    <div class="arch" id="arch">
      {
        lanes.map((lane) => (
          <div class="lane">
            <h3 class="lane-title">{lane}</h3>
            <ol class="chain">
              {nodes
                .filter((n) => n.lane === lane)
                .map((n) => (
                  <li class="node-item">
                    <button type="button" class="node" aria-expanded="false">
                      {n.name}
                    </button>
                    <div class="node-dropdown" hidden>
                      <p data-d-role>
                        <strong>Role:</strong> {n.role}
                      </p>
                      <p>
                        <strong>Why:</strong> <span data-d-why>{n.why}</span>
                      </p>
                      {n.adr && (
                        <p class="adr-link">
                          <a href={n.adr} target="_blank" rel="noopener">
                            Read the decision record
                          </a>
                        </p>
                      )}
                    </div>
                  </li>
                ))}
            </ol>
          </div>
        ))
      }
    </div>
  </section>

  <section id="security">
    <h2>Security self-audit</h2>
    <p>
      This page reads its own response headers in your browser, right now.
      Nothing in the table is hard-coded.
    </p>

    <div class="audit" id="audit">
      <div class="scroll">
        <table>
          <thead>
            <tr>
              <th scope="col">Header</th>
              <th scope="col">Status</th>
              <th scope="col">Value</th>
            </tr>
          </thead>
          <tbody>
            {
              auditHeaders.map((h) => (
                <tr data-header={h.name.toLowerCase()}>
                  <th scope="row">
                    {h.name}
                    <small>{h.purpose}</small>
                  </th>
                  <td data-status>Reading…</td>
                  <td data-value class="value">
                    –
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p id="audit-summary" role="status">Reading headers…</p>
    </div>

    <p>
      <a
        id="observatory"
        href="https://developer.mozilla.org/en-US/observatory"
        target="_blank"
        rel="noopener">Re-scan this site with MDN Observatory</a
      >
    </p>
  </section>
</Layout>

<script>
  // Interactive architecture diagram (Accordion).
  const arch = document.getElementById("arch");

  if (arch) {
    const buttons = Array.from(
      arch.querySelectorAll<HTMLButtonElement>(".node"),
    );

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const dropdown = button.nextElementSibling as HTMLElement | null;
        const isExpanded = button.getAttribute("aria-expanded") === "true";

        // Close all other accordions
        arch.querySelectorAll<HTMLElement>(".node-dropdown").forEach((d) => {
          d.hidden = true;
        });
        buttons.forEach((b) => b.setAttribute("aria-expanded", "false"));

        // Open the clicked accordion if it wasn't already open
        if (!isExpanded && dropdown) {
          dropdown.hidden = false;
          button.setAttribute("aria-expanded", "true");
        }
      });
    });
  }

  // Security self-audit: read this page's real response headers.
  const audit = document.getElementById("audit");

  if (audit) {
    const summary = document.getElementById("audit-summary") as HTMLElement;
    const local = ["localhost", "127.0.0.1"].includes(location.hostname);
    const observatory = document.getElementById(
      "observatory",
    ) as HTMLAnchorElement | null;

    if (observatory && !local) {
      observatory.href = `https://developer.mozilla.org/en-US/observatory/analyze?host=${encodeURIComponent(location.hostname)}`;
    }

    fetch(location.href, { method: "HEAD", cache: "no-store" })
      .then((res) => {
        const rows = audit.querySelectorAll<HTMLElement>("tr[data-header]");
        let present = 0;

        rows.forEach((row) => {
          const value = res.headers.get(row.dataset.header as string);
          const statusCell = row.querySelector("[data-status]") as HTMLElement;
          const valueCell = row.querySelector("[data-value]") as HTMLElement;

          if (value) {
            present++;
            row.dataset.state = "ok";
            statusCell.textContent = "Present";
            valueCell.textContent =
              value.length > 70 ? `${value.slice(0, 67)}…` : value;
            valueCell.title = value;
          } else {
            row.dataset.state = "missing";
            statusCell.textContent = "Missing";
            valueCell.textContent = "–";
          }
        });

        summary.textContent =
          `${present} of ${rows.length} headers present.` +
          (local
            ? " The local dev server sends almost none of these, so check the deployed site."
            : "");
      })
      .catch(() => {
        summary.textContent = "Could not read the headers from this page.";
      });
  }
</script>

<style>
  .project + .project {
    margin-top: 4rem;
    padding-top: 4rem;
    border-top: 1px solid var(--rule);
  }

  .facts {
    margin: 2rem 0 1.5rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  /* Architecture */
  .arch {
    margin-top: 2rem;
  }

  .lane {
    margin-bottom: 1.75rem;
  }

  .lane-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-soft);
    margin-bottom: 0.6rem;
  }

  .chain {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0;
  }

  .chain li {
    display: flex;
    align-items: center;
  }

  .chain li + li::before {
    content: "";
    width: 1.25rem;
    height: 2px;
    background: var(--rule);
  }

  .node {
    padding: 0.55rem 0.95rem;
    font: inherit;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 8px;
    cursor: pointer;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .node:hover {
    border-color: var(--ink-soft);
  }

  .node[aria-pressed="true"] {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
    transform: translateY(-1px);
  }

  .detail {
    margin-top: 0.5rem;
    padding: 1.5rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 8px;
  }

  .detail h3 {
    margin-bottom: 0.5rem;
  }

  .detail p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 560px) {
    .chain {
      flex-direction: column;
      align-items: stretch;
      gap: 0.5rem;
    }

    .chain li + li::before {
      display: none;
    }

    .node {
      width: 100%;
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .node {
      transition: none;
    }

    .node[aria-pressed="true"] {
      transform: none;
    }
  }

  /* Security audit */
  .scroll {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  th,
  td {
    padding: 0.7rem 0.75rem 0.7rem 0;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--rule);
  }

  thead th {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-soft);
  }

  tbody th {
    font-weight: 600;
    white-space: nowrap;
  }

  tbody th small {
    display: block;
    font-weight: 400;
    color: var(--ink-soft);
    white-space: normal;
    min-width: 12rem;
  }

  .value {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.8rem;
    color: var(--ink-soft);
    word-break: break-all;
    min-width: 10rem;
  }

  tr[data-state="ok"] [data-status] {
    color: var(--live);
    font-weight: 600;
  }

  tr[data-state="missing"] [data-status] {
    color: var(--alert);
    font-weight: 600;
  }

  #audit-summary {
    margin: 1rem 0 0.5rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
</style>
