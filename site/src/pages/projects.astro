---
import Layout from "../layouts/Layout.astro";
import { projects } from "../data/site";
---

<Layout
  title="Projects"
  description="Projects with architecture and engineering notes."
>
  <section id="projects">
    <h1>Projects</h1>

    {
      projects.map((p) => (
        <article class="project" id={p.slug}>
          <h2>{p.title}</h2>
          <p>{p.summary}</p>

          <dl class="rows facts">
            <dt>Stack</dt>
            <dd>{p.stack.join(", ")}</dd>
            {p.details.map((d) => (
              <>
                <dt>{d.label}</dt>
                <dd>{d.text}</dd>
              </>
            ))}
          </dl>

          {p.links.length > 0 && (
            <p class="links">
              {p.links.map((l) => (
                <a href={l.href} target="_blank" rel="noopener">
                  {l.label}
                </a>
              ))}
            </p>
          )}
        </article>
      ))
    }
  </section>
</Layout>

<style>
  .project + .project {
    margin-top: 4rem;
    padding-top: 4rem;
    border-top: 1px solid var(--rule);
  }

  .facts {
    margin: 2rem 0 1.5rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
</style>
