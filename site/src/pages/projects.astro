---
import Layout from "../layouts/Layout.astro";
import { projects } from "../data/site";
---

<Layout title="Projects" description="Selected projects and engineering work.">
  <section id="projects">
    <h1>Projects</h1>

    {
      projects.map((project) => (
        <article class="project">
          <h2>
            <a href={`/projects/${project.slug}/`}>{project.title}</a>
          </h2>
          <p>{project.summary}</p>
          <p class="tech">{project.stack.join(", ")}</p>
          <p>
            <a href={`/projects/${project.slug}/`}>View project details</a>
          </p>
        </article>
      ))
    }
  </section>
</Layout>

<style>
  .project + .project {
    margin-top: 3rem;
    padding-top: 3rem;
    border-top: 1px solid var(--rule);
  }

  .project h2 {
    margin-bottom: 0.4rem;
  }

  .tech {
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
</style>
