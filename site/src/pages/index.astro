---
import Layout from "../layouts/Layout.astro";
import {
  profile,
  certifications,
  inProgress,
  projects,
  experience,
  skills,
} from "../data/site";

const showCerts = certifications.length > 0 || inProgress.length > 0;
---

<Layout title="Home">
  <section id="about">
    <h1>{profile.name}</h1>
    <p class="role-line">{profile.role}</p>

    <div class="about">
      {
        profile.photo && (
          <img
            class="photo"
            src={profile.photo}
            alt={`Portrait of ${profile.name}`}
            width="144"
            height="180"
          />
        )
      }
      <div>
        {profile.about.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  {
    showCerts && (
      <section id="certifications">
        <h2>Certifications</h2>
        {certifications.length > 0 && (
          <ul class="certs">
            {certifications.map((c) => (
              <li class="cert">
                {c.image && (
                  <img
                    src={c.image}
                    alt=""
                    width="72"
                    height="72"
                    loading="lazy"
                  />
                )}
                <span class="cert-name">{c.name}</span>
                {c.issuer && <span class="muted">{c.issuer}</span>}
                {c.code && <span class="cert-code">{c.code}</span>}
                {c.url && (
                  <a href={c.url} target="_blank" rel="noopener">
                    Verify
                  </a>
                )}
              </li>
            ))}
          </ul>
        )}
        {inProgress.length > 0 && (
          <>
            <h3>In progress</h3>
            <ul class="plain">
              {inProgress.map((c) => (
                <li>
                  {c.name}
                  {c.code && <span class="muted"> ({c.code})</span>}
                </li>
              ))}
            </ul>
          </>
        )}
      </section>
    )
  }

  <section id="projects">
    <h2>Projects</h2>
    {
      projects.map((p) => (
        <article class="project">
          <h3>
            <a href="/projects">{p.title}</a>
          </h3>
          <p>{p.summary}</p>
          <p class="tech">{p.stack.join(", ")}</p>
        </article>
      ))
    }
  </section>

  {
    experience.length > 0 && (
      <section id="experience">
        <h2>Experience</h2>
        {experience.map((e) => (
          <article class="job">
            <h3>
              {e.role}, {e.company}
            </h3>
            <p class="muted">{e.period}</p>
            <ul>
              {e.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </article>
        ))}
      </section>
    )
  }

  <section id="skills">
    <h2>Skills</h2>
    <dl class="rows">
      {
        skills.map((s) => (
          <>
            <dt>{s.group}</dt>
            <dd>{s.items.join(", ")}</dd>
          </>
        ))
      }
    </dl>
  </section>

  <section id="contact">
    <h2>Contact</h2>
    <dl class="rows">
      <dt>Email</dt>
      <dd>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <button type="button" class="copy" data-copy={profile.email}
          >Copy</button
        >
      </dd>
      <dt>LinkedIn</dt>
      <dd>
        <a href={profile.linkedin} target="_blank" rel="noopener"
          >{profile.linkedin.replace("https://www.", "")}</a>
      </dd>
      {
        profile.github && (
          <>
            <dt>GitHub</dt>
            <dd>
              <a href={profile.github} target="_blank" rel="noopener">
                {profile.github.replace("https://", "")}
              </a>
            </dd>
          </>
        )
      }
      <dt>Resume</dt>
      <dd><a href={profile.resume} download>Download PDF</a></dd>
    </dl>
  </section>
</Layout>

<script>
  // Click-to-copy email.
  const copyButton = document.querySelector<HTMLButtonElement>("[data-copy]");

  copyButton?.addEventListener("click", async () => {
    const original = copyButton.textContent;
    try {
      await navigator.clipboard.writeText(copyButton.dataset.copy as string);
      copyButton.textContent = "Copied";
    } catch {
      copyButton.textContent = "Copy failed";
    }
    setTimeout(() => (copyButton.textContent = original), 2000);
  });
</script>

<style>
  .role-line {
    font-size: 1.3rem;
    color: var(--ink-soft);
    margin-bottom: 2.5rem;
  }

  .about {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
  }

  .about > div {
    min-width: 0;
    flex: 1;
  }

  .photo {
    flex: none;
    width: 9rem;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 6px;
  }

  @media (max-width: 560px) {
    .about {
      flex-direction: column;
      gap: 1.25rem;
    }
  }

  /* Certifications */
  .certs {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 1rem;
  }

  .cert {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    padding: 1.25rem 1rem;
    text-align: center;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 8px;
    font-size: 0.95rem;
  }

  .cert img {
    margin-bottom: 0.6rem;
  }

  .cert-name {
    font-weight: 600;
    line-height: 1.3;
  }

  .cert-code,
  .muted {
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .plain {
    list-style: none;
    padding: 0;
  }

  /* Projects and experience */
  .project h3,
  .job h3 {
    margin-bottom: 0.4rem;
  }

  .tech {
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .job + .job {
    margin-top: 2rem;
  }

  .job ul {
    padding-left: 1.25rem;
  }

  .copy {
    margin-left: 0.75rem;
    padding: 0.1rem 0.7rem;
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 6px;
    cursor: pointer;
  }

  .copy:hover {
    background: var(--paper);
    border-color: var(--ink-soft);
  }
</style>
