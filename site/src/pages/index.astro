			If you would like to get in touch with me, please feel free to reach out via email or connect with me on LinkedIn.
		</p>
		<ul>
			<li>Email: <a href="mailto:racell.sincioco@gmail.com">racell.sincioco@gmail.com</a></li>
			<li>LinkedIn: <a href="https://www.linkedin.com/in/racell-gabriel-sincioco/" target="_blank">Racell Sincioco</a></li>
		</ul>
	</section>
</Layout>

<script>
	// Fetch live data from deployed Cloud Run container
	async function updateVisitorCount() {
		const counterElement = document.getElementById('visitor-count');
		
		
		try {
			const response = await fetch('https://visitor-api-240644792863.us-central1.run.app/api/visitor-count');
			if (!response.ok) {
				throw new Error('Network response was not ok');
			}
			const data = await response.json();
			if (counterElement) {
				counterElement.innerText = data.count;
			} 
		} catch (error) {
			if (counterElement) {
				counterElement.innerText = 'Unavailable';
			}
		}
	}
	updateVisitorCount();
</script>

<style> 
	h1, h2 {
		margin-bottom: 1rem;
		color: #0056b3;
	}
	
	p, ul {
		margin-bottom: 1rem;
	}

	ul {
		margin-left: 1.5rem;
	}

	hr {
		margin: 3rem 0;
		border: 0;
		border-top: 1px solid #ddd;
	}
</style>
