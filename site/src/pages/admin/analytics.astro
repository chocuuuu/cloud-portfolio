---
import Layout from "../../layouts/Layout.astro";
import { profile } from "../../data/site";

const googleClientId =
  import.meta.env.PUBLIC_GOOGLE_OAUTH_CLIENT_ID ||
  "240644792863-iacdaa4uig74pb3g3f0rn123ue2bgr9u.apps.googleusercontent.com";
---

<Layout title="Private analytics" description="Owner-only portfolio analytics dashboard.">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <section
    class="analytics"
    id="analytics"
    data-api={profile.analyticsApi}
    data-client-id={googleClientId}
  >
    <header class="analytics-header">
      <p class="eyebrow">Owner access only</p>
      <h1>Portfolio analytics</h1>
      <p class="lede">
        Aggregated traffic, resume downloads, referrers, and 404 probing. Visitor
        IP addresses and raw request records are never sent to this dashboard.
      </p>
    </header>

    <p class="notice" id="setup-notice" role="status" hidden>
      Google sign-in is not configured yet. Add the Google OAuth web client ID
      as the <code>GOOGLE_OAUTH_CLIENT_ID</code> GitHub Actions variable, then
      deploy again.
    </p>

    <div id="sign-in">
      <div id="google-sign-in"></div>
      <p class="status" id="sign-in-status" role="status">
        Sign in with the owner Google account to load private metrics.
      </p>
    </div>

    <div id="dashboard" hidden>
      <form id="filters" class="filters">
        <div class="date-range">
          <label>
            From
            <input id="start-date" type="date" required />
          </label>
          <label>
            To
            <input id="end-date" type="date" required />
          </label>
        </div>
        <label class="display-filter">
          Display
          <select id="display-mode">
            <option value="chart">Charts</option>
            <option value="table">Tables</option>
          </select>
        </label>
        <label class="search-filter">
          Filter labels
          <input id="search" type="search" placeholder="Browser, source, path…" />
        </label>
        <label class="check">
          <input id="include-bots" type="checkbox" />
          Include bot requests
        </label>
        <div class="filter-actions">
          <button type="submit">Apply filters</button>
          <button type="button" class="secondary" id="sign-out">Sign out</button>
        </div>
      </form>

      <p class="status" id="dashboard-status" role="status" aria-live="polite"></p>
      <h2 class="section-title">Overview</h2>
      <div class="cards" id="summary"></div>

      <p class="notice">
        Visitor counts are privacy-preserving daily visitor IDs. A person
        returning on another day is counted again. Country or city is not
        present in the available Firebase Hosting logs, so this dashboard does
        not infer or export location.
      </p>
      <p class="subtle">
        Probing counts are 404 requests only; they indicate paths that were not
        found, not confirmed attacks. The source breakdown uses <code>src</code>{" "}
        tags on resume links. Referrer hosts are shown separately.
      </p>

      <div class="reports">
        <section class="report">
          <h2>Daily activity</h2>
          <div class="report-content" id="daily"></div>
        </section>
        <section class="report">
          <h2>Browsers</h2>
          <div class="report-content" id="browsers"></div>
        </section>
        <section class="report">
          <h2>Traffic sources and referrers</h2>
          <div class="report-content" id="referrers"></div>
        </section>
        <section class="report">
          <h2>Resume link sources</h2>
          <div class="report-content" id="sources"></div>
        </section>
        <section class="report">
          <h2>404 paths</h2>
          <div class="report-content" id="probes"></div>
        </section>
      </div>
    </div>
  </section>
</Layout>

<script>
  type AnalyticsRow = {
    report: string;
    dimension: string;
    label: string;
    day: string | null;
    eventCount: number;
    visitorCount: number;
    botCount: number;
  };

  type GoogleIdentity = {
    accounts: {
      id: {
        initialize: (options: {
          client_id: string;
          callback: (response: { credential: string }) => void;
        }) => void;
        renderButton: (
          element: HTMLElement,
          options: { theme: string; size: string; text: string },
        ) => void;
      };
    };
  };

  const root = document.getElementById("analytics") as HTMLElement;
  const api = root.dataset.api;
  const clientId = root.dataset.clientId;
  const signIn = document.getElementById("sign-in") as HTMLElement;
  const signInButton = document.getElementById("google-sign-in") as HTMLElement;
  const signInStatus = document.getElementById("sign-in-status") as HTMLElement;
  const setupNotice = document.getElementById("setup-notice") as HTMLElement;
  const dashboard = document.getElementById("dashboard") as HTMLElement;
  const dashboardStatus = document.getElementById("dashboard-status") as HTMLElement;
  const startDate = document.getElementById("start-date") as HTMLInputElement;
  const endDate = document.getElementById("end-date") as HTMLInputElement;
  const includeBots = document.getElementById("include-bots") as HTMLInputElement;
  const displayMode = document.getElementById("display-mode") as HTMLSelectElement;
  const search = document.getElementById("search") as HTMLInputElement;
  const form = document.getElementById("filters") as HTMLFormElement;
  const signOut = document.getElementById("sign-out") as HTMLButtonElement;
  const rowsByReport: Record<string, AnalyticsRow[]> = {};
  let idToken = "";

  const today = new Date();
  const todayText = today.toISOString().slice(0, 10);
  const earliest = new Date(today);
  earliest.setUTCDate(earliest.getUTCDate() - 89);
  startDate.value = earliest.toISOString().slice(0, 10);
  endDate.value = todayText;
  startDate.max = todayText;
  endDate.max = todayText;

  const reportRows = (report: string) => rowsByReport[report] ?? [];

  function createCard(label: string, value: number, note: string) {
    const card = document.createElement("article");
    card.className = "card";
    const title = document.createElement("span");
    title.className = "card-label";
    title.textContent = label;
    const amount = document.createElement("strong");
    amount.textContent = value.toLocaleString();
    const caption = document.createElement("small");
    caption.textContent = note;
    card.append(title, amount, caption);
    return card;
  }

  function renderSummary() {
    const target = document.getElementById("summary") as HTMLElement;
    const pageViews = reportRows("summary").find((row) => row.dimension === "page_views");
    const downloads = reportRows("summary").find((row) => row.dimension === "resume_downloads");
    const probes = reportRows("summary").find((row) => row.dimension === "security_probes");
    const count = (row: AnalyticsRow | undefined) =>
      row ? row.eventCount + (includeBots.checked ? row.botCount : 0) : 0;
    const visitorDays = (row: AnalyticsRow | undefined) => row?.visitorCount ?? 0;
    const bots = reportRows("summary").reduce((sum, row) => sum + row.botCount, 0);

    target.replaceChildren(
      createCard("Page views", count(pageViews), "human requests, plus bots when selected"),
      createCard("Unique visitor-days", visitorDays(pageViews), "daily pseudonymous IDs; human traffic"),
      createCard("Resume downloads", count(downloads), "file requests; plus bots when selected"),
      createCard("Download visitor-days", visitorDays(downloads), "daily pseudonymous IDs; human traffic"),
      createCard("Bot requests", bots, "page and resume requests"),
      createCard("404 probes", probes?.eventCount ?? 0, "not found requests"),
    );
  }

  function visibleRows(rows: AnalyticsRow[]) {
    const query = search.value.trim().toLocaleLowerCase();
    return rows
      .filter((row) => !query || row.label.toLocaleLowerCase().includes(query))
      .filter((row) => includeBots.checked || row.dimension === "probe_path" || row.botCount === 0 || row.eventCount > 0);
  }

  function renderReport(targetId: string, rows: AnalyticsRow[]) {
    const target = document.getElementById(targetId) as HTMLElement;
    const filtered = visibleRows(rows);
    target.replaceChildren();

    if (filtered.length === 0) {
      const empty = document.createElement("p");
      empty.className = "empty";
      empty.textContent = "No matching data for this date range.";
      target.append(empty);
      return;
    }

    if (displayMode.value === "table") {
      const table = document.createElement("table");
      const head = document.createElement("thead");
      const headerRow = document.createElement("tr");
      for (const text of ["Label", "Requests", "Visitor-days", "Bot requests"]) {
        const cell = document.createElement("th");
        cell.scope = "col";
        cell.textContent = text;
        headerRow.append(cell);
      }
      head.append(headerRow);
      const body = document.createElement("tbody");
      for (const row of filtered) {
        const tr = document.createElement("tr");
        const label = document.createElement("th");
        label.scope = "row";
        label.textContent = row.day ? `${row.day} · ${row.dimension.replaceAll("_", " ")}` : row.label;
        const values = [
          row.eventCount + (includeBots.checked ? row.botCount : 0),
          row.visitorCount,
          row.botCount,
        ];
        tr.append(label);
        for (const value of values) {
          const cell = document.createElement("td");
          cell.textContent = value.toLocaleString();
          tr.append(cell);
        }
        body.append(tr);
      }
      table.append(head, body);
      target.append(table);
      return;
    }

    const max = Math.max(...filtered.map((row) => row.eventCount + (includeBots.checked ? row.botCount : 0)), 1);
    for (const row of filtered) {
      const item = document.createElement("div");
      item.className = "bar-row";
      const label = document.createElement("span");
      label.className = "bar-label";
      label.textContent = row.day ? `${row.day} · ${row.dimension.replaceAll("_", " ")}` : row.label;
      const track = document.createElement("span");
      track.className = "bar-track";
      const bar = document.createElement("span");
      bar.className = "bar";
      const value = row.eventCount + (includeBots.checked ? row.botCount : 0);
      bar.style.width = `${Math.max((value / max) * 100, value > 0 ? 1 : 0)}%`;
      track.append(bar);
      const amount = document.createElement("strong");
      amount.textContent = value.toLocaleString();
      item.append(label, track, amount);
      target.append(item);
    }
  }

  function renderDashboard() {
    renderSummary();
    renderReport("daily", reportRows("daily"));
    renderReport("browsers", reportRows("breakdown").filter((row) => row.dimension === "browser"));
    renderReport("referrers", reportRows("breakdown").filter((row) => row.dimension === "referrer"));
    renderReport("sources", reportRows("breakdown").filter((row) => row.dimension === "resume_source"));
    renderReport("probes", reportRows("breakdown").filter((row) => row.dimension === "probe_path"));
  }

  async function loadAnalytics() {
    dashboardStatus.textContent = "Loading analytics…";
    const params = new URLSearchParams({
      startDate: startDate.value,
      endDate: endDate.value,
    });
    try {
      const response = await fetch(`${api}?${params.toString()}`, {
        headers: { Authorization: `Bearer ${idToken}` },
        cache: "no-store",
      });
      const result = await response.json();
      if (!response.ok) {
        throw new Error(result.error ?? `Analytics request failed (${response.status})`);
      }
      for (const key of Object.keys(rowsByReport)) delete rowsByReport[key];
      for (const row of result.rows as AnalyticsRow[]) {
        (rowsByReport[row.report] ??= []).push(row);
      }
      renderDashboard();
      dashboardStatus.textContent = `Updated for ${startDate.value} through ${endDate.value}.`;
    } catch (error) {
      dashboardStatus.textContent = error instanceof Error ? error.message : "Unable to load analytics.";
    }
  }

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    void loadAnalytics();
  });
  includeBots.addEventListener("change", renderDashboard);
  displayMode.addEventListener("change", renderDashboard);
  search.addEventListener("input", renderDashboard);
  signOut.addEventListener("click", () => {
    idToken = "";
    dashboard.hidden = true;
    signIn.hidden = false;
    signInStatus.textContent = "Signed out. Sign in again to load private metrics.";
  });

  if (!api || !clientId) {
    setupNotice.hidden = false;
  } else {
    const script = document.createElement("script");
    script.src = "https://accounts.google.com/gsi/client";
    script.async = true;
    script.defer = true;
    script.onload = () => {
      const google = (window as Window & { google?: GoogleIdentity }).google;
      if (!google) {
        signInStatus.textContent = "Google sign-in could not be loaded. Check the page security policy and try again.";
        return;
      }
      google.accounts.id.initialize({
        client_id: clientId,
        callback: ({ credential }) => {
          idToken = credential;
          signIn.hidden = true;
          dashboard.hidden = false;
          void loadAnalytics();
        },
      });
      google.accounts.id.renderButton(signInButton, {
        theme: "outline",
        size: "large",
        text: "signin_with",
      });
    };
    script.onerror = () => {
      signInStatus.textContent = "Google sign-in could not be loaded. Check your connection and try again.";
    };
    document.head.append(script);
  }
</script>

<style>
  .analytics {
    width: 100%;
    max-width: 1100px;
    --analytics-accent: #12714a;
  }

  .analytics-header {
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .eyebrow {
    margin-bottom: 0.65rem;
    color: var(--analytics-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .analytics h1 {
    margin-bottom: 0.8rem;
    font-size: clamp(2.2rem, 5vw, 3.4rem);
  }

  .lede {
    max-width: 68ch;
    margin-bottom: 0;
    color: var(--ink-soft);
    text-align: left;
  }

  .notice,
  .subtle {
    padding: 0.9rem 1rem;
    border: 1px solid var(--rule);
    border-radius: 10px;
    color: var(--ink-soft);
    text-align: left;
  }

  .notice {
    background: color-mix(in srgb, var(--analytics-accent) 6%, var(--paper));
  }

  .subtle {
    font-size: 0.9rem;
  }

  .filters {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(8rem, 0.7fr) minmax(11rem, 1fr) auto;
    align-items: end;
    gap: 1rem;
    margin: 1.5rem 0 0.75rem;
    padding: 1.1rem;
    border: 1px solid var(--rule);
    border-radius: 12px;
    background: var(--paper);
  }

  .date-range {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .filters label {
    display: grid;
    gap: 0.35rem;
    color: var(--ink-soft);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .filters input,
  .filters select,
  .filters button {
    width: 100%;
    min-width: 0;
    min-height: 2.75rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: 7px;
    color: var(--ink);
    background: var(--paper);
    font: inherit;
  }

  .filters input:focus-visible,
  .filters select:focus-visible {
    border-color: var(--signal);
  }

  .filters .check {
    display: flex;
    align-items: center;
    align-self: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    white-space: nowrap;
  }

  .filters .check input {
    width: 1rem;
    min-height: 1rem;
    accent-color: var(--analytics-accent);
  }

  .filter-actions {
    display: flex;
    gap: 0.55rem;
  }

  .filters button {
    width: auto;
    padding-inline: 0.9rem;
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
    cursor: pointer;
    font-weight: 650;
    white-space: nowrap;
  }

  .filters button:hover {
    background: var(--ink-soft);
  }

  .filters button.secondary {
    border-color: var(--rule);
    background: transparent;
    color: var(--ink);
  }

  .filters button.secondary:hover {
    background: var(--fog);
  }

  .status {
    min-height: 1.5rem;
    margin: 0 0 1rem;
    color: var(--ink-soft);
    font-size: 0.88rem;
    text-align: left;
  }

  .section-title {
    margin: 1.7rem 0 0.9rem;
    font-size: 1.35rem;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
    margin: 0 0 1.25rem;
  }

  .analytics :global(.card) {
    display: grid;
    align-content: start;
    gap: 0.3rem;
    min-width: 0;
    padding: 1rem 1.1rem;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--paper);
    box-shadow: 0 2px 8px rgba(22, 33, 43, 0.035);
  }

  .analytics :global(.card-label),
  .analytics :global(.card small),
  .analytics :global(.empty) {
    color: var(--ink-soft);
  }

  .analytics :global(.card-label) {
    font-size: 0.86rem;
    font-weight: 600;
  }

  .analytics :global(.card strong) {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
  }

  .analytics :global(.card small) {
    font-size: 0.77rem;
    line-height: 1.4;
  }

  .reports {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .report {
    min-width: 0;
    padding: 1.1rem;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--paper);
  }

  .report:first-child {
    grid-column: 1 / -1;
  }

  .report h2 {
    margin: 0 0 1rem;
    font-size: 1.08rem;
    letter-spacing: -0.01em;
  }

  .report-content {
    display: grid;
    gap: 0.7rem;
  }

  .analytics :global(.empty) {
    margin: 0;
    text-align: left;
  }

  .analytics :global(.bar-row) {
    display: grid;
    grid-template-columns: minmax(7rem, 1fr) minmax(4rem, 2fr) auto;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.86rem;
  }

  .analytics :global(.bar-label) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .analytics :global(.bar-track) {
    height: 0.55rem;
    overflow: hidden;
    border-radius: 999px;
    background: var(--fog);
  }

  .analytics :global(.bar) {
    display: block;
    height: 100%;
    min-width: 0;
    border-radius: inherit;
    background: var(--analytics-accent);
  }

  .analytics :global(.bar-row strong) {
    min-width: 2.5rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .analytics :global(.report table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.84rem;
    text-align: left;
  }

  .analytics :global(.report th),
  .analytics :global(.report td) {
    padding: 0.55rem 0.45rem;
    border-bottom: 1px solid var(--rule);
  }

  .analytics :global(.report thead th) {
    color: var(--ink-soft);
    font-weight: 600;
  }

  .analytics :global(.report tbody th) {
    font-weight: 500;
  }

  .analytics :global(.report td) {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 900px) {
    .filters {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .search-filter {
      grid-column: span 1;
    }

    .filter-actions {
      justify-content: end;
    }
  }

  @media (max-width: 600px) {
    .filters,
    .date-range {
      grid-template-columns: minmax(0, 1fr);
    }

    .filters .check {
      justify-self: start;
    }

    .filter-actions {
      justify-content: stretch;
    }

    .filter-actions button {
      flex: 1;
    }

    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.65rem;
    }

    .analytics :global(.card) {
      padding: 0.85rem;
    }

    .analytics :global(.card strong) {
      font-size: 1.65rem;
    }

    .reports {
      grid-template-columns: minmax(0, 1fr);
    }

    .report:first-child {
      grid-column: auto;
    }

    .analytics :global(.bar-row) {
      grid-template-columns: minmax(5.5rem, 1fr) minmax(3rem, 1.4fr) auto;
      gap: 0.5rem;
      font-size: 0.78rem;
    }

    .analytics :global(.report) {
      overflow-x: auto;
    }
  }
</style>
