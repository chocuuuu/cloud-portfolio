---
import { execSync } from 'node:child_process';

const fullSha =
	process.env.GITHUB_SHA ??
	(() => {
		try {
			return execSync('git rev-parse HEAD', { stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim();
		} catch {
			return '';
		}
	})();

const sha = fullSha.slice(0, 7);
const repo = process.env.GITHUB_REPOSITORY; // "owner/name" in GitHub Actions
const commitUrl = repo && fullSha ? `https://github.com/${repo}/commit/${fullSha}` : '';

const built = new Date();
const builtLabel = `${built.toISOString().slice(0, 16).replace('T', ' ')} UTC`;
---

<footer class="sysinfo" aria-labelledby="sysinfo-title">
	<h2 id="sysinfo-title">How this site runs</h2>

	<dl class="sys">
		<dt>Commit</dt>
		<dd>
			{
				sha ? (
					commitUrl ? (
						<a href={commitUrl} target="_blank" rel="noopener">
							<code>{sha}</code>
						</a>
					) : (
						<code>{sha}</code>
					)
				) : (
					'Unknown'
				)
			}
		</dd>

		<dt>Built</dt>
		<dd><time datetime={built.toISOString()}>{builtLabel}</time></dd>

		<dt>Hosting</dt>
		<dd>Firebase Hosting, static Astro build</dd>

		<dt>Cloud Run</dt>
		<dd class="svc" data-service="cloud-run" data-state="checking">
			<i class="dot" aria-hidden="true"></i>
			<span data-service-text>Checking…</span>
			<span class="badge" title="Measured from your browser on this visit">Live</span>
		</dd>

		<dt>Firestore</dt>
		<dd class="svc" data-service="firestore" data-state="checking">
			<i class="dot" aria-hidden="true"></i>
			<span data-service-text>Checking…</span>
			<span class="badge" title="Confirmed by the counter write on this visit">Live</span>
		</dd>
	</dl>

	<p class="links">
		<a href="/projects/serverless-cloud-portfolio/#architecture">See the architecture</a>
		<a href="/projects/serverless-cloud-portfolio/#security">Run the security audit</a>
	</p>
</footer>

<style>
	.sysinfo {
		margin-top: 1rem;
		padding: 3rem 0 4rem;
		border-top: 1px solid var(--rule);
		font-size: 0.9rem;
		color: var(--ink-soft);
	}

	h2 {
		font-size: 1rem;
		font-weight: 650;
		color: var(--ink);
		margin-bottom: 1rem;
	}

	.sys {
		display: grid;
		grid-template-columns: minmax(0, 7rem) minmax(0, 1fr);
		gap: 0.5rem 1.5rem;
		margin: 0 0 1.25rem;
	}

	dt {
		font-weight: 600;
	}

	dd {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.2rem 0.5rem;
	}

	code {
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.9em;
	}

	.dot {
		flex: none;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--rule);
	}

	.svc[data-state='up'] .dot {
		background: var(--live);
		animation: livepulse 2.4s ease-out infinite;
	}

	.svc[data-state='down'] .dot {
		background: var(--alert);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
		margin: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.svc[data-state='up'] .dot {
			animation: none;
		}
	}

	@media (max-width: 560px) {
		.sys {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.1rem;
		}

		dd {
			margin-bottom: 0.75rem;
		}
	}
</style>