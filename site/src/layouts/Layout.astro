---
// import "@fontsource-variable/bricolage-grotesque";
// import "@fontsource-variable/source-serif-4";
import "@fontsource-variable/google-sans-flex/wght.css";
import { profile, navItems } from "../data/site";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = `Portfolio of ${profile.name}, an aspiring cloud engineer building on Google Cloud.`,
} = Astro.props;

// Added brand
// <img src="/logo.svg" alt={brand} height="28" />   (put logo.svg in site/public/)
const brand = "chocuuuu";

const onProjects = Astro.url.pathname.startsWith("/projects");
const pageTitle = title === "Home" ? profile.name : title;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // Scroll reveal is opt-in: no JS or reduced motion means everything is simply visible.
      if (
        "IntersectionObserver" in window &&
        !matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        document.documentElement.classList.add("js");
      }
    </script>
    <title>{pageTitle} | Aspiring Cloud Engineer</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <div class="shell">
      <header class="rail">
        <a class="brand" href="/" aria-label={`${brand}, home`}>{brand}</a>

        <nav aria-label="Primary">
          <ul>
            {
              navItems.map((item) => (
                <li>
                  <a
                    href={`/#${item.id}`}
                    data-id={item.id}
                    aria-current={
                      onProjects && item.id === "projects" ? "page" : undefined
                    }
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="rail-foot">
          <div
            class="views"
            id="views"
            data-api={profile.visitorApi}
            data-loading
          >
            <span class="views-label">Profile views</span>
            <span class="views-count" id="views-count" aria-live="polite"
              >–</span
            >
            <span
              class="loader"
              id="views-loader"
              role="img"
              aria-label="Loading view count"
            >
              <span class="stage" style="--n:0"><i></i>Hosting</span>
              <span class="stage" style="--n:1"><i></i>Cloud Run</span>
              <span class="stage" style="--n:2"><i></i>Firestore</span>
            </span>
          </div>

          <a
            href={profile.resume}
            class="resume"
            download
            aria-label="Download resume"
          >
            <svg
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5M5 20h14"></path>
            </svg>
            <span>Download resume</span>
          </a>
        </div>
      </header>

      <main id="main">
        <div class="page">
          <slot />
        </div>
      </main>
    </div>

    <script is:inline define:vars={{ onProjects }}>
      // Highlight the section in view (home page only).
      if (!onProjects && "IntersectionObserver" in window) {
        const links = document.querySelectorAll("nav a[data-id]");
        const sections = document.querySelectorAll(".page > section[id]");
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              links.forEach((link) => {
                if (link.dataset.id === entry.target.id)
                  link.setAttribute("aria-current", "location");
                else link.removeAttribute("aria-current");
              });
            }
          },
          { rootMargin: "-30% 0px -60% 0px" },
        );
        sections.forEach((s) => observer.observe(s));
      }
    </script>

    <script is:inline>
      // Reveal each block as it scrolls into view, with a light stagger inside a section.
      if (document.documentElement.classList.contains("js")) {
        const revealer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("in");
              revealer.unobserve(entry.target);
            }
          },
          { threshold: 0.08, rootMargin: "0px 0px -6% 0px" },
        );
        document.querySelectorAll(".page > section").forEach((section) => {
          Array.from(section.children).forEach((child, i) => {
            child.style.setProperty("--d", Math.min(i * 70, 280) + "ms");
            revealer.observe(child);
          });
        });
      }
    </script>

    <script>
      // Profile views. Counted once per browser session, then reused across pages.
      const views = document.getElementById("views");

      if (views) {
        const countEl = document.getElementById("views-count") as HTMLElement;
        const loader = document.getElementById("views-loader");

        const MIN_LOADER_MS = 1800;
        const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
        const started = performance.now();

        const show = (text: string) => {
          countEl.textContent = text;
          loader?.remove();
          views.removeAttribute("data-loading");
        };

        // Keep the loading widget up for at least 1.8s, even if the API answers sooner.
        const showAfterMinimum = (text: string) => {
          const remaining = calm
            ? 0
            : Math.max(0, MIN_LOADER_MS - (performance.now() - started));
          setTimeout(() => show(text), remaining);
        };

        let cached: string | null = null;
        try {
          cached = sessionStorage.getItem("views-count");
        } catch {}

        if (cached) {
          show(cached);
        } else {
          fetch(views.dataset.api as string)
            .then((res) => {
              if (!res.ok) throw new Error(`HTTP ${res.status}`);
              return res.json();
            })
            .then((data) => {
              const text = Number(data.count).toLocaleString();
              try {
                sessionStorage.setItem("views-count", text);
              } catch {}
              showAfterMinimum(text);
            })
            .catch(() => showAfterMinimum("–"));
        }
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --fog: #f5f6f7;
    --paper: #ffffff;
    --ink: #16212b;
    --ink-soft: #55626d;
    --rule: #dde3e7;
    --signal: #2457d6;

    --font:
      "Google Sans Flex Variable", system-ui, -apple-system, "Segoe UI", Roboto,
      sans-serif;
    --rail-width: 15rem;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    margin: 0;
    background: var(--fog);
    color: var(--ink);
    font-family: var(--font);
    font-size: 1.0625rem;
    line-height: 1.65;
    overflow-wrap: break-word;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  h1,
  h2,
  h3 {
    line-height: 1.12;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
    text-wrap: balance;
  }

  h1 {
    font-size: clamp(2.4rem, 7vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  h2 {
    font-size: clamp(1.5rem, 3.5vw, 1.85rem);
    font-weight: 650;
    margin-bottom: 1.75rem;
  }

  h3 {
    font-size: 1.15rem;
    font-weight: 600;
  }

  p,
  ul,
  ol,
  dl {
    margin: 0 0 1.1rem;
  }

  a {
    color: var(--signal);
    text-underline-offset: 0.2em;
  }

  a:hover {
    text-decoration-thickness: 2px;
  }

  :focus-visible {
    outline: 3px solid var(--signal);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .page > section {
    padding: 5rem 0;
    scroll-margin-top: 1rem;
  }

  .page > section:first-child {
    padding-top: 2rem;
  }

  .page > section + section {
    border-top: 1px solid var(--rule);
  }

  /* Scroll reveal: only active when the head script added .js */
  .js .page > section > * {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.6s ease,
      transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
    transition-delay: var(--d, 0ms);
  }

  .js .page > section > *.in {
    opacity: 1;
    transform: none;
  }

  /* Label / value rows used for skills, contact and project details */
  .rows {
    display: grid;
    grid-template-columns: minmax(0, 11rem) minmax(0, 1fr);
    gap: 0.9rem 2rem;
    margin: 0;
  }

  .rows dt {
    font-weight: 600;
    color: var(--ink-soft);
  }

  .rows dd {
    margin: 0;
  }

  @media (max-width: 900px) {
    .page > section {
      padding: 3.5rem 0;
      scroll-margin-top: 6rem;
    }
  }

  @media (max-width: 560px) {
    .rows {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.1rem;
    }

    .rows dd {
      margin-bottom: 1rem;
    }
  }
</style>

<style>
  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    background: var(--ink);
    color: var(--paper);
    padding: 0.5rem 1rem;
    border-radius: 4px;
    z-index: 20;
  }

  .skip:focus {
    top: 1rem;
  }

  .shell {
    display: grid;
    grid-template-columns: var(--rail-width) minmax(0, 1fr);
    min-height: 100vh;
  }

  /* The rail shares the page background */
  .rail {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    padding: 2.5rem 1.75rem 2rem;
    background: var(--fog);
    border-right: 1px solid var(--rule);
  }

  .brand {
    color: var(--ink);
    text-decoration: none;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  nav {
    margin-top: 3rem;
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* The current section grows slightly and gets a marker that slides in */
  nav a {
    position: relative;
    display: block;
    padding: 0.4rem 0 0.4rem 0.9rem;
    margin-left: -0.9rem;
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 500;
    transform-origin: left center;
    transition:
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
      color 0.2s ease;
  }

  nav a::before {
    content: "";
    position: absolute;
    left: 0;
    top: 18%;
    bottom: 18%;
    width: 2px;
    border-radius: 2px;
    background: var(--signal);
    transform: scaleY(0);
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  nav a:hover {
    color: var(--ink);
  }

  nav a[aria-current] {
    color: var(--ink);
    transform: scale(1.18);
  }

  nav a[aria-current]::before {
    transform: scaleY(1);
  }

  /* Footer: views above the download button */
  .rail-foot {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .views {
    min-height: 3.4rem;
  }

  .views-label {
    display: block;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .views-count {
    display: block;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .views[data-loading] .views-count {
    display: none;
  }

  /* Loading widget, removed from the page as soon as the count arrives */
  .loader {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 0.45rem;
  }

  .loader::before {
    content: "";
    position: absolute;
    top: 0.28rem;
    left: 0.3rem;
    right: 0.3rem;
    height: 2px;
    background: var(--rule);
  }

  .stage {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.68rem;
    line-height: 1.1;
    color: var(--ink-soft);
  }

  .stage i {
    position: relative;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--rule);
    animation: beat 1.8s ease-in-out infinite;
    animation-delay: calc(var(--n) * 0.35s);
  }

  @keyframes beat {
    0%,
    100% {
      background: var(--rule);
      transform: scale(1);
    }
    40% {
      background: var(--signal);
      transform: scale(1.4);
    }
  }

  .resume {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.65rem 1rem;
    background: var(--ink);
    color: #fff;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 6px;
    transition: background 0.15s ease;
  }

  .resume:hover {
    background: var(--signal);
  }

  .resume svg {
    flex: none;
    transition: transform 0.2s ease;
  }

  .resume:hover svg {
    transform: translateY(2px);
  }

  @media (prefers-reduced-motion: reduce) {
    nav a,
    nav a::before {
      transition: none;
    }

    .stage i {
      animation: none;
    }

    .resume:hover svg {
      transform: none;
    }
  }

  /* Content is centered in the space beside the rail */
  main {
    min-width: 0;
    padding: 0 clamp(1.25rem, 5vw, 4rem);
  }

  .page {
    width: 100%;
    max-width: 42rem;
    margin-inline: auto;
  }

  /* Narrow windows: the rail becomes a sticky top bar */
  @media (max-width: 900px) {
    .shell {
      display: block;
    }

    .rail {
      height: auto;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.4rem 1rem;
      padding: 0.7rem 1.25rem;
      border-right: 0;
      border-bottom: 1px solid var(--rule);
      z-index: 10;
    }

    .brand {
      font-size: 1.1rem;
    }

    .rail-foot {
      margin-top: 0;
      flex-direction: row;
      align-items: center;
      gap: 0.9rem;
    }

    .views {
      min-height: 0;
      display: flex;
      align-items: baseline;
      gap: 0.35rem;
    }

    .views-label {
      font-size: 0.8rem;
    }

    .views-count,
    .views[data-loading] .views-count {
      display: inline;
      font-size: 1rem;
    }

    .loader {
      display: none;
    }

    .resume {
      padding: 0.4rem 0.8rem;
      font-size: 0.85rem;
    }

    nav {
      order: 3;
      width: 100%;
      margin-top: 0;
      overflow-x: auto;
      scrollbar-width: none;
    }

    nav ul {
      display: flex;
      gap: 1.5rem;
      padding-block: 0.2rem;
    }

    nav a {
      margin-left: 0;
      padding: 0.3rem 0;
      white-space: nowrap;
      transform-origin: center;
    }

    nav a::before {
      top: auto;
      left: 0;
      right: 0;
      bottom: 0;
      width: auto;
      height: 2px;
      transform: scaleX(0);
    }

    nav a[aria-current] {
      transform: scale(1.12);
    }

    nav a[aria-current]::before {
      transform: scaleX(1);
    }
  }

  @media (max-width: 560px) {
    .views-label {
      display: none;
    }

    .views-count::after {
      content: " views";
      font-size: 0.8rem;
      font-weight: 400;
      color: var(--ink-soft);
    }

    .resume span {
      display: none;
    }

    .resume {
      padding: 0.45rem 0.6rem;
    }
  }
</style>
