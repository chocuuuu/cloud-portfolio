---
const { title } = Astro.props
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Aspiring Cloud Engineer</title>
	</head>
	<body>
		<aside class="sidebar">
			<div class="brand">
				<h2>Racell Sincioco</h2>
				<p2>Aspiring Cloud Engineer</p2>
			</div>

			<nav>
				<ul>
					<li><a href="/#about">01 About</a></li>
					<li><a href="/#projects">02 Projects</a></li>
					<li><a href="/#experience">03 Experience</a></li>
					<li><a href="/#contact">04 Contact</a></li>
				</ul>
			</nav>

			<div class="sidebar-footer">
				<a href="/resume.pdf" class="btn-download" download>Download Resume</a>
			</div>
		</aside>

		<main class="content">
			<slot />
		</main>

		<style>
			:root {
				--bg-color: #faf8f5;
				--text-color:#111111;
				--sidebar-bg-color: #ffffff;
				--border-color: #e5e5e5;
				--accent-color: #0056b3;
				--font-base: system-ui, -apple-system, sans-serif;
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			body {
				display: flex;
				font-family: var(--font-base);
				background-color: var(--bg-color);
				color: var(--text-color);
				line-height: 1.6;
			}

			.sidebar {
				width: 280px;
				height: 100vh;
				position: fixed;
				background-color: var(--sidebar-bg-color);
				border-right: 1px solid var(--border-color);
				display: flex;
				flex-direction: column;
				padding: 2rem;
			}

			.brand h2 {
				font-size: 1.5rem;
				font-weight: 700;
			}

			.brand p {
				font-size: 0.9rem;
				color: #666;
				margin-top: 2rem;
			}

			nav ul {
				list-style: none;
				flex-grow: 1;
			}

			nav ul li {
				margin-bottom: 1rem;
			}

			nav ul li a {
				text-decoration: none;
				color: var(--text-color);
				font-weight: 500;
				transition: color 0.2s ease;
			}

			nav ul li a:hover {
				color: var(--accent-color);
			}

			.sidebar-footer {
				margin-top: auto;
			}

			.btn-download {
				display: block;
				text-align: center;
				padding: 0.75rem;
				background-color: var(--text-color);
				color: var(--bg-color);
				text-decoration: none;
				border-radius: 4px;
				font-size: 0.9rem;
				transition: background 0.2s ease;
			}

			.btn-download:hover {
				background-color: var(--accent-color);
			}

			.content {
				margin-left: 280px;
				padding: 4rem;
				width: calc(100% - 280px);
				max-width: 1000px;
			}

			section {
				min-height: 80vh;
				margin-bottom: 4rem;
				padding-top: 2rem;
			}
		</style>
	</body>
</html>