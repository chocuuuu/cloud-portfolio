---
// import "@fontsource-variable/bricolage-grotesque";
// import "@fontsource-variable/source-serif-4";
import "@fontsource-variable/google-sans-flex/wght.css";
import { profile, navItems } from "../data/site";
import SiteInfo from "../components/SiteInfo.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = `Portfolio of ${profile.name}, an aspiring cloud engineer building on Google Cloud.`,
} = Astro.props;

// Added brand for SEO
const brand = "chocuuuu";

const onProjects = Astro.url.pathname.startsWith("/projects");
const pageTitle = title === "Home" ? profile.name : title;

// Commands for the quick-jump palette
const commands = [
  ...navItems.map((item) => ({
    label: `Go to ${item.label}`,
    group: "Navigate",
    href: `/#${item.id}`,
  })),
  {
    label: "See the architecture",
    group: "Navigate",
    href: "/projects#architecture",
  },
  {
    label: "Run the security self-audit",
    group: "Navigate",
    href: "/projects#security",
  },
  { label: "Copy email address", group: "Actions", copy: profile.email },
  {
    label: "Download resume",
    group: "Actions",
    href: profile.resume,
    download: true,
  },
  {
    label: "Open LinkedIn",
    group: "Links",
    href: profile.linkedin,
    external: true,
  },
  ...(profile.github
    ? [
        {
          label: "Open GitHub",
          group: "Links",
          href: profile.github,
          external: true,
        },
      ]
    : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle} | Aspiring Cloud Engineer</title>
  </head>
  <body data-page={onProjects ? "projects" : "home"}>
    <a class="skip" href="#main">Skip to content</a>

    <div class="shell">
      <header class="rail">
        <a class="brand" href="/" aria-label={`${brand}, home`}>{brand}</a>

        <nav aria-label="Primary">
          <ul>
            {
              navItems.map((item) => (
                <li>
                  <a
                    href={`/#${item.id}`}
                    data-id={item.id}
                    aria-current={
                      onProjects && item.id === "projects" ? "page" : undefined
                    }
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <button
          type="button"
          class="cmdk"
          data-open-palette
          aria-label="Open quick jump"
        >
          <span>Quick jump</span>
          <kbd data-kbd>Ctrl K</kbd>
        </button>

        <div class="rail-foot">
          <div
            class="views"
            id="views"
            data-api={profile.visitorApi}
            data-loading
          >
            <span class="views-label">Profile views</span>
            <span class="views-count" id="views-count" aria-live="polite"
              >–</span
            >
            <span
              class="badge views-badge"
              title="Counted in Firestore through the Cloud Run API"
            >
              <i class="dot live" aria-hidden="true"></i>Live · Firestore
            </span>
            <span
              class="loader"
              id="views-loader"
              role="img"
              aria-label="Loading view count"
            >
              <span class="stage" style="--n:0"><i></i>Hosting</span>
              <span class="stage" style="--n:1"><i></i>Cloud Run</span>
              <span class="stage" style="--n:2"><i></i>Firestore</span>
            </span>
          </div>

          <a
            href={profile.resume}
            class="resume"
            download
            aria-label="Download resume"
          >
            <svg
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5M5 20h14"></path>
            </svg>
            <span>Download resume</span>
          </a>
        </div>
      </header>

      <main id="main">
        <div class="page">
          <slot />
          <SiteInfo />
        </div>
      </main>
    </div>

    <dialog
      class="palette"
      id="palette"
      aria-label="Quick jump"
      data-commands={JSON.stringify(commands)}
    >
      <div class="palette-box">
        <input
          id="palette-input"
          type="text"
          role="combobox"
          aria-expanded="true"
          aria-controls="palette-list"
          aria-autocomplete="list"
          placeholder="Jump to a section or run a command"
          autocomplete="off"
          spellcheck="false"
        />
        <ul id="palette-list" role="listbox" aria-label="Commands"></ul>
        <p class="palette-hint">
          <kbd>↑</kbd><kbd>↓</kbd> move <kbd>Enter</kbd> run <kbd>Esc</kbd> close
        </p>
      </div>
    </dialog>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script>
      // Highlight the section in view (home page only).
      const onProjects = document.body.dataset.page === "projects";

      if (!onProjects && "IntersectionObserver" in window) {
        const links = document.querySelectorAll<HTMLElement>("nav a[data-id]");
        const sections = document.querySelectorAll(".page > section[id]");
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              links.forEach((link) => {
                if (link.dataset.id === entry.target.id)
                  link.setAttribute("aria-current", "location");
                else link.removeAttribute("aria-current");
              });
            }
          },
          { rootMargin: "-30% 0px -60% 0px" },
        );
        sections.forEach((section) => observer.observe(section));
      }
    </script>

    <script>
      // Reveal each block as it scrolls into view, with a light stagger inside a section.
      if ("IntersectionObserver" in window) {
        const revealer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("in");
              revealer.unobserve(entry.target);
            }
          },
          { threshold: 0.08, rootMargin: "0px 0px -6% 0px" },
        );

        document.querySelectorAll(".page > section").forEach((section) => {
          Array.from(section.children).forEach((child, i) => {
            (child as HTMLElement).style.setProperty(
              "--d",
              `${Math.min(i * 70, 280)}ms`,
            );
            revealer.observe(child);
          });
        });
      }
    </script>

    <script>
      // Profile views and live service status. One request per browser session, reused across pages.
      type Status = { ok: boolean; ms: number };

      const paintStatus = (status: Status) => {
        document
          .querySelectorAll<HTMLElement>("[data-service]")
          .forEach((el) => {
            const text = el.querySelector("[data-service-text]");
            el.dataset.state = status.ok ? "up" : "down";
            if (!text) return;
            if (el.dataset.service === "cloud-run") {
              text.textContent = status.ok
                ? `Responded in ${status.ms.toLocaleString()} ms`
                : "Not responding";
            } else {
              text.textContent = status.ok
                ? "Counter write succeeded"
                : "Unknown, the API is down";
            }
          });
      };

      const views = document.getElementById("views");

      if (views) {
        const countEl = document.getElementById("views-count") as HTMLElement;
        const loader = document.getElementById("views-loader");

        const MIN_LOADER_MS = 1800;
        const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
        const started = performance.now();

        const show = (text: string) => {
          countEl.textContent = text;
          loader?.remove();
          views.removeAttribute("data-loading");
        };

        // Keep the loading widget up for at least 1.8s, even if the API answers sooner.
        const showAfterMinimum = (text: string) => {
          const remaining = calm
            ? 0
            : Math.max(0, MIN_LOADER_MS - (performance.now() - started));
          setTimeout(() => show(text), remaining);
        };

        let cachedCount: string | null = null;
        let cachedStatus: Status | null = null;
        try {
          cachedCount = sessionStorage.getItem("views-count");
          const raw = sessionStorage.getItem("site-status");
          cachedStatus = raw ? (JSON.parse(raw) as Status) : null;
        } catch {}

        if (cachedCount) {
          show(cachedCount);
          if (cachedStatus) paintStatus(cachedStatus);
        } else {
          const t0 = performance.now();
          fetch(views.dataset.api as string)
            .then((res) => {
              if (!res.ok) throw new Error(`HTTP ${res.status}`);
              return res.json();
            })
            .then((data) => {
              const text = Number(data.count).toLocaleString();
              const status: Status = {
                ok: true,
                ms: Math.round(performance.now() - t0),
              };
              try {
                sessionStorage.setItem("views-count", text);
                sessionStorage.setItem("site-status", JSON.stringify(status));
              } catch {}
              paintStatus(status);
              showAfterMinimum(text);
            })
            .catch(() => {
              paintStatus({ ok: false, ms: 0 });
              showAfterMinimum("–");
            });
        }
      }
    </script>

    <script>
      // Quick-jump palette (Ctrl/Cmd + K).
      type Cmd = {
        label: string;
        group: string;
        href?: string;
        copy?: string;
        download?: boolean;
        external?: boolean;
      };

      const dialog = document.getElementById(
        "palette",
      ) as HTMLDialogElement | null;
      const toast = document.getElementById("toast");

      const notify = (message: string) => {
        if (!toast) return;
        toast.textContent = message;
        toast.classList.add("show");
        setTimeout(() => toast.classList.remove("show"), 2000);
      };

      if (dialog) {
        const commands: Cmd[] = JSON.parse(dialog.dataset.commands ?? "[]");
        const input = document.getElementById(
          "palette-input",
        ) as HTMLInputElement;
        const list = document.getElementById(
          "palette-list",
        ) as HTMLUListElement;
        let results: Cmd[] = commands;
        let active = 0;

        const paintActive = () => {
          list
            .querySelectorAll<HTMLElement>('li[role="option"]')
            .forEach((li, i) => {
              li.setAttribute("aria-selected", String(i === active));
              if (i === active) {
                li.scrollIntoView({ block: "nearest" });
                input.setAttribute("aria-activedescendant", li.id);
              }
            });
        };

        const run = async (cmd: Cmd) => {
          dialog.close();
          if (cmd.copy) {
            try {
              await navigator.clipboard.writeText(cmd.copy);
              notify("Copied to clipboard");
            } catch {
              notify("Copy failed");
            }
            return;
          }
          if (!cmd.href) return;
          if (cmd.external) {
            window.open(cmd.href, "_blank", "noopener");
          } else if (cmd.download) {
            const a = document.createElement("a");
            a.href = cmd.href;
            a.download = "";
            document.body.append(a);
            a.click();
            a.remove();
          } else {
            location.href = cmd.href;
          }
        };

        const render = () => {
          list.replaceChildren();
          if (results.length === 0) {
            const empty = document.createElement("li");
            empty.className = "empty";
            empty.textContent = "No matching commands";
            list.append(empty);
            return;
          }
          results.forEach((cmd, i) => {
            const li = document.createElement("li");
            li.id = `cmd-${i}`;
            li.setAttribute("role", "option");
            const label = document.createElement("span");
            label.textContent = cmd.label;
            const group = document.createElement("small");
            group.textContent = cmd.group;
            li.append(label, group);
            li.addEventListener("mousemove", () => {
              if (active !== i) {
                active = i;
                paintActive();
              }
            });
            li.addEventListener("click", () => run(cmd));
            list.append(li);
          });
          paintActive();
        };

        const filter = () => {
          const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
          results = commands.filter((c) =>
            words.every((w) =>
              `${c.label} ${c.group}`.toLowerCase().includes(w),
            ),
          );
          active = 0;
          render();
        };

        const open = () => {
          if (dialog.open) return;
          input.value = "";
          filter();
          dialog.showModal();
          input.focus();
        };

        input.addEventListener("input", filter);
        input.addEventListener("keydown", (e) => {
          if (e.key === "ArrowDown" || e.key === "ArrowUp") {
            e.preventDefault();
            if (!results.length) return;
            active =
              (active + (e.key === "ArrowDown" ? 1 : -1) + results.length) %
              results.length;
            paintActive();
          } else if (e.key === "Enter") {
            e.preventDefault();
            const cmd = results[active];
            if (cmd) run(cmd);
          }
        });

        // Clicking the dimmed backdrop closes the palette.
        dialog.addEventListener("click", (e) => {
          if (e.target === dialog) dialog.close();
        });

        document.addEventListener("keydown", (e) => {
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
            e.preventDefault();
            if (dialog.open) dialog.close();
            else open();
          }
        });

        document
          .querySelectorAll("[data-open-palette]")
          .forEach((b) => b.addEventListener("click", open));

        const isMac = /Mac|iPhone|iPad/.test(navigator.platform);
        document.querySelectorAll("[data-kbd]").forEach((el) => {
          el.textContent = isMac ? "⌘K" : "Ctrl K";
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --fog: #f5f6f7;
    --paper: #ffffff;
    --ink: #16212b;
    --ink-soft: #55626d;
    --rule: #dde3e7;
    --signal: #2457d6;
    --live: #12714a;
    --alert: #b3261e;

    --font:
      "Google Sans Flex Variable", system-ui, -apple-system, "Segoe UI", Roboto,
      sans-serif;
    --rail-width: 15rem;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    margin: 0;
    background: var(--fog);
    color: var(--ink);
    font-family: var(--font);
    font-size: 1.0625rem;
    line-height: 1.65;
    overflow-wrap: break-word;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  h1,
  h2,
  h3 {
    line-height: 1.12;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
    text-wrap: balance;
  }

  h1 {
    font-size: clamp(2.4rem, 7vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  h2 {
    font-size: clamp(1.5rem, 3.5vw, 1.85rem);
    font-weight: 650;
    margin-bottom: 1.75rem;
  }

  h3 {
    font-size: 1.15rem;
    font-weight: 600;
  }

  p,
  ul,
  ol,
  dl {
    margin: 0 0 1.1rem;
  }

  a {
    color: var(--signal);
    text-underline-offset: 0.2em;
  }

  a:hover {
    text-decoration-thickness: 2px;
  }

  :focus-visible {
    outline: 3px solid var(--signal);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .page > section {
    padding: 5rem 0;
    scroll-margin-top: 1rem;
  }

  .page > section:first-child {
    padding-top: 2rem;
  }

  .page > section + section {
    border-top: 1px solid var(--rule);
  }

  /* Live badge: a small pill with a pulsing dot and the data source */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.05rem 0.6rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: 0.72rem;
    line-height: 1.6;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .dot {
    flex: none;
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--rule);
  }

  .dot.live {
    background: var(--live);
    animation: livepulse 2.4s ease-out infinite;
  }

  @keyframes livepulse {
    0% {
      box-shadow: 0 0 0 0 rgba(18, 113, 74, 0.45);
    }
    70%,
    100% {
      box-shadow: 0 0 0 0.4rem rgba(18, 113, 74, 0);
    }
  }

  kbd {
    font: inherit;
    font-size: 0.75rem;
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--fog);
    color: var(--ink-soft);
  }

  /* Quick-jump palette (its list items are created by script, so these rules are global) */
  .palette {
    border: 0;
    padding: 0;
    background: transparent;
    width: min(36rem, calc(100vw - 2rem));
    margin: 14vh auto auto;
    overflow: visible;
    color: var(--ink);
  }

  .palette::backdrop {
    background: rgba(22, 33, 43, 0.35);
    backdrop-filter: blur(3px);
  }

  .palette[open] {
    animation: palette-in 0.18s ease-out;
  }

  @keyframes palette-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
  }

  .palette-box {
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 12px;
    box-shadow: 0 20px 50px rgba(22, 33, 43, 0.22);
    overflow: hidden;
    font-family: var(--font);
  }

  .palette input {
    width: 100%;
    padding: 1rem 1.1rem;
    border: 0;
    border-bottom: 1px solid var(--rule);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 1.05rem;
    outline: none;
  }

  .palette ul {
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    max-height: 50vh;
    overflow-y: auto;
  }

  .palette li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0.75rem;
    border-radius: 8px;
    cursor: pointer;
  }

  .palette li[aria-selected="true"] {
    background: var(--fog);
  }

  .palette li small {
    color: var(--ink-soft);
    font-size: 0.8rem;
  }

  .palette li.empty {
    color: var(--ink-soft);
    cursor: default;
  }

  .palette-hint {
    margin: 0;
    padding: 0.6rem 1rem;
    border-top: 1px solid var(--rule);
    font-size: 0.8rem;
    color: var(--ink-soft);
  }

  body:has(dialog[open]) {
    overflow: hidden;
  }

  .toast {
    position: fixed;
    left: 50%;
    bottom: 1.5rem;
    transform: translate(-50%, 0.5rem);
    padding: 0.55rem 1rem;
    background: var(--ink);
    color: #fff;
    border-radius: 8px;
    font-size: 0.9rem;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
    z-index: 30;
  }

  .toast.show {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .dot.live,
    .palette[open] {
      animation: none;
    }

    .toast {
      transition: none;
    }
  }

  /* Scroll reveal: applies only when scripting is on and the visitor allows motion */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .page > section > * {
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity 0.6s ease,
        transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
      transition-delay: var(--d, 0ms);
    }

    .page > section > *.in {
      opacity: 1;
      transform: none;
    }
  }

  /* Label / value rows used for skills, contact and project details */
  .rows {
    display: grid;
    grid-template-columns: minmax(0, 11rem) minmax(0, 1fr);
    gap: 0.9rem 2rem;
    margin: 0;
  }

  .rows dt {
    font-weight: 600;
    color: var(--ink-soft);
  }

  .rows dd {
    margin: 0;
  }

  @media (max-width: 900px) {
    .page > section {
      padding: 3.5rem 0;
      scroll-margin-top: 6rem;
    }
  }

  @media (max-width: 560px) {
    .rows {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.1rem;
    }

    .rows dd {
      margin-bottom: 1rem;
    }
  }
</style>

<style>
  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    background: var(--ink);
    color: var(--paper);
    padding: 0.5rem 1rem;
    border-radius: 4px;
    z-index: 20;
  }

  .skip:focus {
    top: 1rem;
  }

  .shell {
    display: grid;
    grid-template-columns: var(--rail-width) minmax(0, 1fr);
    min-height: 100vh;
  }

  /* The rail shares the page background */
  .rail {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    padding: 2.5rem 1.75rem 2rem;
    background: var(--fog);
    border-right: 1px solid var(--rule);
  }

  .brand {
    color: var(--ink);
    text-decoration: none;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  nav {
    margin-top: 3rem;
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* The current section grows slightly and gets a marker that slides in */
  nav a {
    position: relative;
    display: block;
    padding: 0.4rem 0 0.4rem 0.9rem;
    margin-left: -0.9rem;
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 500;
    transform-origin: left center;
    transition:
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
      color 0.2s ease;
  }

  nav a::before {
    content: "";
    position: absolute;
    left: 0;
    top: 18%;
    bottom: 18%;
    width: 2px;
    border-radius: 2px;
    background: var(--signal);
    transform: scaleY(0);
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  nav a:hover {
    color: var(--ink);
  }

  nav a[aria-current] {
    color: var(--ink);
    transform: scale(1.18);
  }

  nav a[aria-current]::before {
    transform: scaleY(1);
  }

  /* Footer: views above the download button */
  .rail-foot {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .views {
    min-height: 3.4rem;
  }

  .views-label {
