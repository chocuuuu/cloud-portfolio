---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/source-serif-4";
import { profile, navItems } from "../data/site";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = `Portfolio of ${profile.name}, an aspiring cloud engineer building on Google Cloud.`,
} = Astro.props;

const onProjects = Astro.url.pathname.startsWith("/projects");
const pageTitle = title === "Home" ? profile.name : title;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle} | Aspiring Cloud Engineer</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <div class="shell">
      <header class="rail">
        <a class="brand" href="/">{profile.name}</a>

        <nav aria-label="Primary">
          <ul>
            {
              navItems.map((item) => (
                <li>
                  <a
                    href={`/#${item.id}`}
                    data-id={item.id}
                    aria-current={
                      onProjects && item.id === "projects" ? "page" : undefined
                    }
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <a href={profile.resume} class="resume" download>Download resume</a>
      </header>

      <main id="main">
        <div class="page">
          <slot />
        </div>
      </main>
    </div>

    <script is:inline define:vars={{ onProjects }}>
      // Highlight the section in view
      if (!onProjects && "IntersectionObserver" in window) {
        const links = document.querySelectorAll("nav a[data-id]");
        const sections = document.querySelectorAll(".page > section[id]");
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              links.forEach((link) => {
                if (link.dataset.id === entry.target.id)
                  link.setAttribute("aria-current", "location");
                else link.removeAttribute("aria-current");
              });
            }
          },
          { rootMargin: "-30% 0px -60% 0px" },
        );
        sections.forEach((s) => observer.observe(s));
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --fog: #f5f6f7;
    --paper: #ffffff;
    --ink: #16212b;
    --ink-soft: #55626d;
    --rule: #dde3e7;
    --signal: #2457d6;
    --live: #12714a;
    --alert: #b3261e;

    --font-display: "Bricolage Grotesque Variable", system-ui, sans-serif;
    --font-text: "Source Serif 4 Variable", Georgia, serif;
    --rail-width: 15rem;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    margin: 0;
    background: var(--fog);
    color: var(--ink);
    font-family: var(--font-text);
    font-size: 1.0625rem;
    line-height: 1.7;
    overflow-wrap: break-word;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    line-height: 1.12;
    letter-spacing: -0.015em;
    margin: 0 0 1rem;
    text-wrap: balance;
  }

  h1 {
    font-size: clamp(2.4rem, 7vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  h2 {
    font-size: clamp(1.5rem, 3.5vw, 1.85rem);
    font-weight: 650;
    margin-bottom: 1.75rem;
  }

  h3 {
    font-size: 1.15rem;
    font-weight: 600;
  }

  p,
  ul,
  ol,
  dl {
    margin: 0 0 1.1rem;
  }

  a {
    color: var(--signal);
    text-underline-offset: 0.2em;
  }

  a:hover {
    text-decoration-thickness: 2px;
  }

  :focus-visible {
    outline: 3px solid var(--signal);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* Sections: generous space, one hairline between them */
  .page > section {
    padding: 5rem 0;
    scroll-margin-top: 1rem;
  }

  .page > section:first-child {
    padding-top: 2rem;
  }

  .page > section + section {
    border-top: 1px solid var(--rule);
  }

  /* Label / value rows used for skills, contact and project details */
  .rows {
    display: grid;
    grid-template-columns: minmax(0, 11rem) minmax(0, 1fr);
    gap: 0.9rem 2rem;
    margin: 0;
  }

  .rows dt {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--ink-soft);
  }

  .rows dd {
    margin: 0;
  }

  @media (max-width: 900px) {
    .page > section {
      padding: 3.5rem 0;
      scroll-margin-top: 6rem;
    }
  }

  @media (max-width: 560px) {
    .rows {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.1rem;
    }

    .rows dd {
      margin-bottom: 1rem;
    }
  }
</style>

<style>
  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    background: var(--ink);
    color: var(--paper);
    padding: 0.5rem 1rem;
    border-radius: 4px;
    z-index: 20;
  }

  .skip:focus {
    top: 1rem;
  }

  .shell {
    display: grid;
    grid-template-columns: var(--rail-width) minmax(0, 1fr);
    min-height: 100vh;
  }

  .rail {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    padding: 2.5rem 1.75rem 2rem;
    background: var(--paper);
    border-right: 1px solid var(--rule);
    font-family: var(--font-display);
  }

  .brand {
    color: var(--ink);
    text-decoration: none;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  nav {
    margin-top: 3rem;
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: block;
    padding: 0.35rem 0 0.35rem 0.9rem;
    margin-left: -0.9rem;
    border-left: 2px solid transparent;
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 500;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  nav a:hover {
    color: var(--ink);
  }

  nav a[aria-current] {
    color: var(--ink);
    font-weight: 650;
    border-left-color: var(--signal);
  }

  .resume {
    margin-top: auto;
    display: block;
    text-align: center;
    padding: 0.65rem 1rem;
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 4px;
    transition: background 0.15s ease;
  }

  .resume:hover {
    background: var(--signal);
  }

  /* Content is centered in the space beside the rail */
  main {
    min-width: 0;
    padding: 0 clamp(1.25rem, 5vw, 4rem);
  }

  .page {
    width: 100%;
    max-width: 42rem;
    margin-inline: auto;
  }

  /* Narrow windows: rail becomes a sticky top bar */
  @media (max-width: 900px) {
    .shell {
      display: block;
    }

    .rail {
      height: auto;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.4rem 1rem;
      padding: 0.7rem 1.25rem;
      border-right: 0;
      border-bottom: 1px solid var(--rule);
      z-index: 10;
    }

    .brand {
      font-size: 1.1rem;
    }

    .resume {
      margin-top: 0;
      padding: 0.35rem 0.8rem;
      font-size: 0.85rem;
    }

    nav {
      order: 3;
      width: 100%;
      margin-top: 0;
      overflow-x: auto;
      scrollbar-width: none;
    }

    nav ul {
      display: flex;
      gap: 1.25rem;
    }

    nav a {
      margin-left: 0;
      padding: 0.3rem 0;
      border-left: 0;
      border-bottom: 2px solid transparent;
      white-space: nowrap;
    }

    nav a[aria-current] {
      border-bottom-color: var(--signal);
    }
  }
</style>
